# ─────────────────────────────────────────────────────────────────────────────
# Report Card Engine — environment variables
#
# DECENTRALISATION NOTE:
#   This engine has NO privileged relayer key.  Any funded Stellar account
#   may submit WASM analysis flags.  The on-chain contract verifies the WASM
#   hash against ledger state, so fraudulent submissions are rejected.
#
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Network: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet

# Deployed Report Card registry contract ID (output of scripts/deploy.sh).
REGISTRY_CONTRACT_ID=

# ── Submitter account (NOT a privileged key) ─────────────────────────────────
# Secret key of ANY funded Stellar account that pays transaction fees.
# This is not an owner or admin — any account works.
# Omit to run in dry-run mode (analysis only, no on-chain writes).
SUBMITTER_SECRET=

# ── Endpoints ────────────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Scheduler ────────────────────────────────────────────────────────────────
# Re-scan interval in milliseconds. Default: 300000 (5 minutes).
ENGINE_INTERVAL_MS=300000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

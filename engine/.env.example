# ─────────────────────────────────────────────────────────────────────────────
# Report Card — Engine environment variables
# Copy this file to .env and fill in your values before running the engine.
# Never commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────

# Which Stellar network to target.
# Values: testnet | mainnet | futurenet
# Default: testnet
STELLAR_NETWORK=testnet

# ── Registry contract ────────────────────────────────────────────────────────

# Contract ID of the deployed Report Card registry (output of scripts/deploy.sh).
# Format: C followed by 55 uppercase alphanumeric characters (56 chars total).
# Required — the engine will run in dry-run mode (no on-chain writes) if unset.
REGISTRY_CONTRACT_ID=

# ── Relayer account ──────────────────────────────────────────────────────────

# Secret key of the Stellar account that is authorised to call set_flags().
# This is the account passed as `relayer` when the registry was initialised.
# Format: S followed by 55 uppercase alphanumeric characters (56 chars total).
# Required — the engine will run in dry-run mode (no on-chain writes) if unset.
# WARNING: Keep this secret. Never expose it in logs, CI output, or source code.
RELAYER_SECRET=

# ── RPC / Horizon endpoints ──────────────────────────────────────────────────

# Soroban RPC endpoint used to fetch WASM bytecode and simulate transactions.
# Defaults to the public SDF testnet RPC if not set.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon API endpoint used to fetch operation counts and TVL proxy.
# Defaults to the public SDF testnet Horizon if not set.
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Scheduler ────────────────────────────────────────────────────────────────

# How often the engine re-scans all contracts in data/contracts.json, in
# milliseconds.  Set to 0 to disable the scheduler (process exits after one run).
# Default: 300000 (5 minutes)
ENGINE_INTERVAL_MS=300000

# ── Source verification ───────────────────────────────────────────────────────

# Set to "true" to enable Docker-based reproducible builds for source
# verification (M3).  Requires Docker to be installed and running.
# When "false" (or unset), the engine will attempt a native Cargo build
# and fall back to source_verified=false if Cargo is unavailable.
ENABLE_DOCKER_VERIFY=true

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: error | warn | info | debug
# Default: info
LOG_LEVEL=info

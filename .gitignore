# ─────────────────────────────────────────────────────────────────────────────
# Report Card — root .gitignore
# Covers: Rust/Cargo, Node.js, Next.js, environment files, OS artifacts
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── TypeScript build output ───────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Next.js ──────────────────────────────────────────────────────────────────
.next/
out/
.vercel/

# ── Rust / Cargo ──────────────────────────────────────────────────────────────
target/
Cargo.lock
**/*.rs.bk

# Compiled WASM artifacts (built by stellar contract build)
*.wasm
*.optimized.wasm

# ── Stellar CLI ───────────────────────────────────────────────────────────────
# Identity files created by `stellar keys generate`
.stellar/

# Deploy logs written by scripts/deploy.sh
deploy_*.log

# ── IDE & editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
